{
    "name": "uuur86/dalue",
    "description": "Map nested arrays, objects and JSON documents into a new structure with a declarative schema.",
    "type": "library",
    "keywords": [
        "mapper",
        "data-mapper",
        "transform",
        "schema",
        "json",
        "array",
        "nested",
        "strobj"
    ],
    "homepage": "https://github.com/uuur86/dalue",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Uğur Biçer",
            "email": "info@ugurbicer.com.tr",
            "role": "lead"
        }
    ],
    "support": {
        "issues": "https://github.com/uuur86/dalue/issues",
        "source": "https://github.com/uuur86/dalue",
        "docs": "https://github.com/uuur86/dalue/wiki"
    },
    "require": {
        "php": ">=7.4",
        "uuur86/strobj": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12 || ^2.0",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.10 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Dalue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dalue\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "examples": "@php examples/run-all.php",
        "phpstan": "phpstan analyse --no-progress",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "check": [
            "@cs",
            "@phpstan",
            "@test"
        ]
    }
}
