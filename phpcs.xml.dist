<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Dalue">
    <description>PSR-12 coding standard for Dalue.</description>

    <file>src</file>
    <file>tests</file>
    <arg name="extensions" value="php" />
    <arg name="colors" />
    <arg value="sp" />

    <rule ref="PSR12" />
</ruleset>
